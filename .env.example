# Notion API Integration Keys
# Create an integration at https://www.notion.so/my-integrations and share your databases with it.
NOTION_API_KEY=ntn_your_notion_api_secret_key_here

# Notion Database IDs (32-character hex strings found in each database URL)
# 1. Site Content Database
NOTION_SITE_CONTENT_DB_ID=your_site_content_database_id

# 2. Projects Database
NOTION_PROJECTS_DB_ID=your_projects_database_id

# 3. Skills Database
NOTION_SKILLS_DB_ID=your_skills_database_id

# 4. Experience Database
NOTION_EXPERIENCE_DB_ID=your_experience_database_id

# 5. Recommendations Database
NOTION_RECOMMENDATIONS_DB_ID=your_recommendations_database_id

# 6. Blog Database
NOTION_BLOG_DB_ID=your_blog_database_id

# 7. Contact Click Log Database
NOTION_CONTACT_LOG_DB_ID=your_contact_log_database_id

# Google Analytics 4 (GA4) Measurement ID
NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX

# Resend Email Notifications (Get free API key at https://resend.com)
RESEND_API_KEY=re_your_resend_api_key_here
NOTIFICATION_EMAIL_TO=isnan.rizqikurniawan@gmail.com
NOTIFICATION_EMAIL_FROM="Portfolio Notification <onboarding@resend.dev>"

